# ===========================
# SUPABASE CONFIGURATION
# ===========================
# Obtén estos valores de tu proyecto Supabase
# Settings → API

# URL de tu proyecto Supabase
VITE_SUPABASE_URL=https://[tu-project-id].supabase.co

# Anon/Public Key (es seguro exponerla en cliente)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================
# DATABASE (para referencia)
# ===========================
# Base de datos: Postgres en Supabase
# Schema: public
# Tablas: obras, imagenes, tecnicas, tags, obra_tags, usuarios_admin
# (Creadas en FASE 0)

# ===========================
# INSTRUCCIONES
# ===========================
# 1. Copia este archivo a .env
# 2. Reemplaza los valores con tus credenciales reales
# 3. NO subas .env a GitHub (está en .gitignore)
# 4. Cada desarrollador tiene su propia copia local
