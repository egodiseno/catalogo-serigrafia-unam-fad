/* ============ TAG SEARCH UI (ISSUE-05) ============ */
.tag-search-wrapper {
  position: relative;
}

.tag-search-row {
  display: flex;
  gap: var(--spacing-sm);
  align-items: center;
}

.tag-search-row .search-input {
