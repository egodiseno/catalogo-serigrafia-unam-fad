/* Nota: la tipografía h1-h6 ya está definida en la sección de tokens UNAM
   (líneas ~228-260). Lo que sigue son estilos de layout y secciones admin. */

h2 {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  margin-bottom: var(--spacing-md);
}

h3 {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  margin-bottom: var(--spacing-sm);
}

p {
  margin-bottom: var(--spacing-md);
  color: var(--color-text-muted);
}

a {
  color: var(--color-blue);
  text-decoration: none;
  transition: color var(--duration-fast) var(--ease);
}

a:hover {
  color: var(--color-blue-dark);
  text-decoration: underline;
}

/* ============ BUTTONS ============ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md) var(--spacing-lg);
  font-family: var(--font-family);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  border: none;
  border-radius: var(--radius);
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease);
  white-space: nowrap;
}

.btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* PRIMARY */
.btn-primary {
  background-color: var(--color-blue);
  color: white;
}

.btn-primary:hover:not(:disabled) {
  background-color: var(--color-blue-dark);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.btn-primary:active:not(:disabled) {
  transform: translateY(0);
  box-shadow: var(--shadow-sm);
}

/* SECONDARY */
.btn-secondary {
  background-color: var(--color-text-light);
  color: white;
}

.btn-secondary:hover:not(:disabled) {
  background-color: var(--color-text-muted);
  box-shadow: var(--shadow-md);
}

/* DANGER */
.btn-danger {
  background-color: var(--color-danger);
  color: white;
}

.btn-danger:hover:not(:disabled) {
  background-color: #c82333;
  box-shadow: var(--shadow-md);
}

/* BLOCK */
.btn-block {
  width: 100%;
}

/* ============ FORMS ============ */
.form-group {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
}

label {
  font-weight: var(--font-weight-medium);
  color: var(--color-text);
}

input[type="text"],
input[type="email"],
input[type="password"],
input[type="number"],
textarea,
select {
  padding: var(--spacing-md) var(--spacing-lg);
  font-family: var(--font-family);
  font-size: var(--font-size-base);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  background-color: var(--color-surface);
  color: var(--color-text);
  transition: all var(--duration-fast) var(--ease);
}

input[type="text"]:focus,
input[type="email"]:focus,
input[type="password"]:focus,
input[type="number"]:focus,
textarea:focus,
select:focus {
  outline: none;
  border-color: var(--color-blue);
  box-shadow: 0 0 0 3px var(--color-blue-light);
  background-color: var(--color-surface);
}

textarea {
  resize: vertical;
  min-height: 100px;
}

select {
  cursor: pointer;
}

.search-input,
.select-input {
  max-width: 300px;
}

/* ============ LOGIN PAGE ============ */
.login-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-blue-dark) 100%);
  padding: var(--spacing-lg);
}

.login-box {
  background: white;
  border-radius: var(--radius);
  box-shadow: var(--shadow-xl);
  padding: var(--spacing-2xl);
  width: 100%;
  max-width: 400px;
}

.login-header {
  text-align: center;
  margin-bottom: var(--spacing-2xl);
}

.login-header h1 {
  color: var(--color-blue);
  margin-bottom: var(--spacing-sm);
}

.login-header p {
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
}

.login-form {
  margin-bottom: var(--spacing-xl);
}

.error-message {
  background-color: #f8d7da;
  color: #721c24;
  padding: var(--spacing-md) var(--spacing-lg);
  border-radius: var(--radius);
  margin-bottom: var(--spacing-lg);
  font-size: var(--font-size-sm);
  border: 1px solid #f5c6cb;
}

.login-footer {
  text-align: center;
  font-size: var(--font-size-sm);
}

.link-forgot {
  color: var(--color-blue);
}

/* ============ DASHBOARD LAYOUT ============ */
.dashboard-container {
  display: flex;
  height: 100vh;
  background-color: var(--color-surface-alt);
}

/* SIDEBAR */
.sidebar {
  width: var(--sidebar-width);
  background-color: var(--color-blue);
  color: white;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-md);
  overflow-y: auto;
}

.sidebar-header {
  padding: var(--spacing-xl);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
}

.logo {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background-color: var(--color-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-blue);
  font-weight: var(--font-weight-bold);
  font-size: var(--font-size-xl);
}

.sidebar-header h2 {
  font-size: var(--font-size-lg);
  margin: 0;
}

.sidebar-nav {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: var(--spacing-lg) 0;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
  padding: var(--spacing-md) var(--spacing-xl);
  background: none;
  border: none;
  color: rgba(255, 255, 255, 0.7);
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
  text-align: left;
  font-family: var(--font-family);
}

.nav-item:hover {
  background-color: rgba(255, 255, 255, 0.1);
  color: white;
}

.nav-item.active {
  background-color: var(--color-gold);
  color: var(--color-blue);
  border-left: 4px solid var(--color-gold-dark);
  padding-left: calc(var(--spacing-xl) - 4px);
  font-weight: var(--font-weight-medium);
}

.nav-icon {
  font-size: var(--font-size-lg);
}

.nav-label {
  flex: 1;
}

.sidebar-footer {
  padding: var(--spacing-lg);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.sidebar-footer .btn {
  background-color: rgba(255, 255, 255, 0.1);
  color: white;
}

.sidebar-footer .btn:hover {
  background-color: rgba(255, 255, 255, 0.2);
}

/* MAIN CONTENT */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ADMIN HEADER */
.admin-header {
  background-color: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  padding: var(--spacing-lg) var(--spacing-2xl);
  height: var(--header-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-sm);
}

.header-left h1 {
  margin-bottom: 0;
  color: var(--color-blue);
}

.header-left p {
  margin: 0;
  font-size: var(--font-size-sm);
}

.header-right {
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
}

.user-info {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  font-size: var(--font-size-sm);
}

.user-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: var(--color-blue-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-lg);
}

/* CONTENT AREA */
.content-area {
  flex: 1;
  overflow-y: auto;
  padding: var(--spacing-2xl);
}

/* SECTIONS */
.section {
  display: none;
}

.section.active {
  display: block;
  animation: fadeIn var(--duration-fast) var(--ease);
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--spacing-2xl);
}

.section-header h2 {
  margin-bottom: 0;
  color: var(--color-blue);
}

.section-header p {
  margin: 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

/* ============ STATS GRID ============ */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--spacing-xl);
  margin-bottom: var(--spacing-2xl);
}

.stat-card {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: var(--spacing-xl);
  text-align: center;
  box-shadow: var(--shadow-sm);
  transition: all var(--duration-normal) var(--ease);
}

.stat-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-4px);
  border-color: var(--color-blue);
}

.stat-value {
  font-size: 32px;
  font-weight: var(--font-weight-bold);
  color: var(--color-blue);
  margin-bottom: var(--spacing-sm);
}

.stat-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* ============ TABLES ============ */
.recent-section,
.filter-bar {
  background-color: var(--color-surface);
  border-radius: var(--radius);
  padding: var(--spacing-xl);
  margin-bottom: var(--spacing-xl);
  box-shadow: var(--shadow-sm);
}

.recent-section h3 {
  color: var(--color-blue);
  margin-bottom: var(--spacing-lg);
}

.filter-bar {
  display: flex;
  gap: var(--spacing-lg);
  flex-wrap: wrap;
  align-items: flex-end;
}

.filter-bar input,
.filter-bar select {
  flex: 1;
  min-width: 200px;
}

table {
  width: 100%;
  border-collapse: collapse;
  background-color: var(--color-surface);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

table thead {
  background-color: var(--color-surface-alt);
  border-bottom: 2px solid var(--color-border);
}

table th {
  padding: var(--spacing-lg);
  text-align: left;
  font-weight: var(--font-weight-bold);
  color: var(--color-text);
  font-size: var(--font-size-sm);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

table td {
  padding: var(--spacing-lg);
  border-bottom: 1px solid var(--color-border);
}

table tbody tr {
  transition: background-color var(--duration-fast) var(--ease);
}

table tbody tr:hover {
  background-color: var(--color-blue-light);
}

table tbody tr:last-child td {
  border-bottom: none;
}

.empty-state {
  text-align: center;
  color: var(--color-text-muted);
  padding: var(--spacing-2xl) !important;
  font-style: italic;
}

/* ============ PAGINATION ============ */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--spacing-lg);
  margin-top: var(--spacing-xl);
  padding: var(--spacing-lg);
  background-color: var(--color-surface);
  border-radius: var(--radius);
}

.count-info {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

/* ============ RESPONSIVE ============ */
@media (max-width: 768px) {
  .dashboard-container {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    height: auto;
  }

  .sidebar-nav {
    flex-direction: row;
    overflow-x: auto;
    padding: var(--spacing-lg);
  }

  .nav-item {
    padding: var(--spacing-md) var(--spacing-lg);
    border-left: none;
    border-bottom: 3px solid transparent;
  }

  .nav-item.active {
    border-left: none;
    border-bottom: 3px solid var(--color-gold-dark);
    padding-left: var(--spacing-lg);
  }

  .main-content {
    height: auto;
    flex: initial;
  }

  .admin-header {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-lg);
    height: auto;
    padding: var(--spacing-lg);
  }

  .header-right {
    width: 100%;
    justify-content: space-between;
  }

  .content-area {
    padding: var(--spacing-lg);
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
  }

  .filter-bar {
    flex-direction: column;
    align-items: stretch;
  }

  .filter-bar input,
  .filter-bar select {
    min-width: unset;
  }

  .section-header {
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .search-input,
  .select-input {
    max-width: unset;
  }

  table {
    font-size: var(--font-size-sm);
  }

  table th,
  table td {
    padding: var(--spacing-md);
  }
}

/* ============ BADGES (estado) ============ */
.badge {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 999px;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  text-transform: capitalize;
}

.badge-borrador  { background: #fff3cd; color: #856404; }
.badge-publicado { background: #d1e7dd; color: #0a3622; }
.badge-archivado { background: #e9ecef; color: #495057; }

/* ============ BTN SMALL + ACTIONS ============ */
.btn-sm {
  padding: 4px 8px;
  font-size: var(--font-size-sm);
  border-radius: 6px;
}

.actions-cell {
  display: flex;
  gap: var(--spacing-sm);
  white-space: nowrap;
}

/* ============ UPLOAD / PREVIEW ============ */
input[type="file"] {
  padding: var(--spacing-sm);
  border: 2px dashed var(--color-border);
  border-radius: var(--radius);
  background: var(--color-surface-alt);
  cursor: pointer;
  width: 100%;
  transition: border-color var(--duration-fast) var(--ease);
}

input[type="file"]:hover {
  border-color: var(--color-blue);
}

.field-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  margin: var(--spacing-xs) 0 0;
}

.imagen-preview {
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--color-surface-alt);
  border-radius: var(--radius);
  border: 1px solid var(--color-border);
}

.imagen-preview img {
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: var(--radius);
  border: 1px solid var(--color-border);
}

/* ============ MODAL ============ */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: var(--spacing-lg);
  animation: fadeIn var(--duration-fast) var(--ease);
}

.modal-dialog {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-xl);
  width: 100%;
  max-width: 560px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-xl);
  border-bottom: 1px solid var(--color-border);
  background: var(--color-blue);
  color: white;
}

.modal-header h3 {
  margin: 0;
  color: white;
}

.modal-close {
  background: none;
  border: none;
  color: rgba(255,255,255,.8);
  font-size: var(--font-size-xl);
  cursor: pointer;
  line-height: 1;
  padding: 4px 8px;
  border-radius: 4px;
  transition: color var(--duration-fast) var(--ease);
}

.modal-close:hover { color: white; }

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: var(--spacing-xl);
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: var(--spacing-lg);
  padding: var(--spacing-lg) var(--spacing-xl);
  border-top: 1px solid var(--color-border);
  background: var(--color-surface-alt);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-lg);
}

.required { color: var(--color-danger); }

/* Alertas dentro del modal */
.form-alert {
  padding: var(--spacing-md) var(--spacing-lg);
  border-radius: var(--radius);
  font-size: var(--font-size-sm);
  margin-top: var(--spacing-lg);
}

.form-alert.success {
  background: #d1e7dd;
  color: #0a3622;
  border: 1px solid #a3cfbb;
}

.form-alert.error {
  background: #f8d7da;
  color: #721c24;
  border: 1px solid #f5c6cb;
}

@media (max-width: 480px) {
  .login-box {
    padding: var(--spacing-xl);
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  table {
    font-size: 12px;
  }

  table th,
  table td {
    padding: var(--spacing-sm);
  }

  .btn {
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: 12px;
  }
}

/* ============ MULTI-IMAGE UPLOAD STYLES ============ */
.image-input-group {
  background-color: var(--color-surface-alt);
  border: 1px dashed var(--color-border);
  border-radius: var(--radius);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
}

.image-input-row {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.image-input-row label {
