/* ══════════════════════════════════════════════════════════════
   SISTEMA DE ICONOS — Lucide + Custom SVG
   ══════════════════════════════════════════════════════════════ */

/* ── Lucide: base ──────────────────────────────────────────── */
[data-lucide] {
  display:      inline-block;
  vertical-align: middle;
  stroke-width: 2;
  color:        currentColor;
  flex-shrink:  0;
}

/* ── Lucide: en botones ────────────────────────────────────── */
.btn [data-lucide] {
  margin-right:  0.4rem;
  position:      relative;
  top:           -1px;          /* alineación óptica con texto */
}

.btn-sm [data-lucide] {
  width:         14px !important;
  height:        14px !important;
  margin-right:  0.3rem;
}

/* ── Lucide: en nav sidebar ────────────────────────────────── */
.nav-item [data-lucide] {
  width:         18px !important;
  height:        18px !important;
  margin-right:  0.5rem;
  flex-shrink:   0;
}

/* ── Wrapper icon-inline ───────────────────────────────────── */
.icon-inline {
  display:        inline-flex;
  align-items:    center;
  justify-content: center;
  vertical-align: middle;
  line-height:    1;
}

/* ── Custom SVG en botones ─────────────────────────────────── */
.btn svg {
  display:        inline-block;
  vertical-align: middle;
  width:          16px;
  height:         16px;
  margin-right:   0.4rem;
  flex-shrink:    0;
}

.btn-sm svg {
  width:          14px;
  height:         14px;
  margin-right:   0.3rem;
}

/* ── Botón solo-icono (sin texto) ──────────────────────────── */
.btn--icon-only {
  padding:     0.4rem;
  line-height: 1;
}

.btn--icon-only [data-lucide],
.btn--icon-only svg {
  margin-right: 0;
}

/* ── Modal-close con icono ─────────────────────────────────── */
.modal-close [data-lucide] {
  width:        16px !important;
  height:       16px !important;
  margin-right: 0;
  display:      block;
}

/* ── Accesibilidad: focus ring en iconos interactivos ──────── */
[data-lucide]:focus-visible {
  outline: 2px solid var(--color-primary, #013B75);
  outline-offset: 2px;
  border-radius:  2px;
}

/* ══════════════════════════════════════════════════════════════
   BOTONES — Refinamientos y utilidades adicionales
   ══════════════════════════════════════════════════════════════ */

/* Tamaño extra-small */
.btn-xs {
  padding:     0.3rem 0.5rem;
  font-size:   0.75rem;
  gap:         0.25rem;
  line-height: 1.2;
}

/* Solo icono (sin texto) — padding cuadrado */
.btn--icon-only,
.btn.btn-sm:not(:has(> :not(i))):not(:has(> :not([data-lucide]))) {
  padding: 0.4rem;
}

/* Alineación de iconos en botones sin margin-right forzado */
.btn > [data-lucide],
.btn > i[data-lucide] {
  flex-shrink: 0;
}

/* Contenedor de acciones en tabla */
.action-buttons {
  display:     inline-flex;
  gap:         0.4rem;
  align-items: center;
}

/* ── btn-danger: override para que icono solo use padding cuadrado */
.btn-danger.btn-sm:not([class*="btn-block"]) {
  padding:   0.4rem 0.5rem;
  min-width: 32px;
}

/* ══════════════════════════════════════════════════════════════
   MODAL HEADER — Fondo azul UNAM
   ══════════════════════════════════════════════════════════════ */

.modal-header {
  background-color: var(--color-primary, #013B75);
  color:            white;
}

.modal-header h2,
.modal-header h3 {
  color: white;
  margin: 0;
}

/* Botón cerrar sobre fondo azul */
.modal-close,
.modal-close-btn {
  color:      white;
  background: transparent;
  border:     1px solid rgba(255, 255, 255, 0.3);
  opacity:    0.85;
}

.modal-close:hover,
.modal-close-btn:hover {
  opacity:    1;
  background: rgba(255, 255, 255, 0.15);
}

/* ══════════════════════════════════════════════════════════════
   IMÁGENES — Galería de imágenes guardadas
   ══════════════════════════════════════════════════════════════ */

.image-grid {
  display:               grid;
  grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  gap:                   0.75rem;
  margin-top:            0.75rem;
}

.image-item {
  position:      relative;
  border-radius: var(--radius-sm, 6px);
  overflow:      hidden;
  aspect-ratio:  1 / 1;
  border:        1px solid var(--color-border, #e9ecef);
  background:    var(--color-bg, #fafafa);
}

.image-item img {
  width:       100%;
  height:      100%;
  object-fit:  cover;
  display:     block;
}

/* Badge "Principal" */
.image-item-badge,
.badge-principal {
  position:         absolute;
  top:              0.4rem;
  left:             0.4rem;
  background-color: var(--color-primary, #013B75);
  color:            white;
  padding:          0.2rem 0.5rem;
  border-radius:    4px;
  font-size:        0.65rem;
  font-weight:      700;
  letter-spacing:   0.02em;
  text-transform:   uppercase;
}

/* Botón eliminar imagen (esquina inferior derecha) */
.image-item-delete {
  position:   absolute;
  bottom:     0.4rem;
  right:      0.4rem;
  padding:    0.3rem;
  min-width:  28px;
  min-height: 28px;
  background: rgba(220, 38, 38, 0.9);
  border:     none;
  border-radius: 4px;
  display:    flex;
  align-items:    center;
  justify-content: center;
  opacity:    0;
  transition: opacity 150ms ease;
}

.image-item:hover .image-item-delete {
  opacity: 1;
}

