# Variables de entorno — Catálogo de Obra Serigráfica
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local o .env a git.

# Supabase — prefijo NEXT_PUBLIC_ requerido para acceso desde el browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Testing únicamente ────────────────────────────────────────────────────────
# Descomenta la siguiente línea en .env.local para omitir el paso de MFA
# durante pruebas locales. NUNCA configurar en Netlify ni en producción.
# NEXT_PUBLIC_SKIP_MFA=true
