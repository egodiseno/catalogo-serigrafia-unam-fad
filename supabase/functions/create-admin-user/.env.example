# ──────────────────────────────────────────────────────────────────────────────
# Edge Function: create-admin-user
# Variables de entorno requeridas
# ──────────────────────────────────────────────────────────────────────────────
#
# En producción (Supabase Cloud), SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY
# se inyectan automáticamente. Solo necesitas configurar en el dashboard:
#   Supabase Dashboard → Settings → Edge Functions → Environment variables
#
# Para desarrollo local con `supabase functions serve`, crea:
#   supabase/.env (raíz del proyecto supabase)
#   y agrega las variables de abajo.
#
# ──────────────────────────────────────────────────────────────────────────────

# URL del proyecto Supabase (auto-inyectada en producción)
SUPABASE_URL=https://<tu-proyecto>.supabase.co

# Clave anónima pública (auto-inyectada en producción)
SUPABASE_ANON_KEY=eyJ...

# ⚠️  SERVICE ROLE KEY — NUNCA exponer en el frontend
# Encuéntrala en: Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
